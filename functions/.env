# Non-secret runtime params for the oauth function (read by firebase-functions params on deploy).
# The client secret is NOT here: set it once with
#   firebase functions:secrets:set OAUTH_CLIENT_SECRET
OAUTH_CLIENT_ID=e68ba60fa2b3c240898a
OAUTH_PROVIDER=github
OAUTH_GIT_HOSTNAME=https://github.com
OAUTH_TOKEN_PATH=/login/oauth/access_token
OAUTH_AUTHORIZE_PATH=/login/oauth/authorize
OAUTH_REDIRECT_URL=
OAUTH_SCOPES=repo,user
